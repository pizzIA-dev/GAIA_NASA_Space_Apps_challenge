# Copiar a .env (nunca versionar .env). Sin secretos aquí.
# Proyecto Google Cloud registrado en Earth Engine (el plan menciona uno de investigación; configurarlo solo por entorno).
EE_PROJECT=
# Ruta LOCAL al JSON de la cuenta de servicio (fuera del repo). Vacío = usar `earthengine authenticate` en desarrollo.
EE_SERVICE_ACCOUNT_FILE=
# Email esperado de la cuenta de servicio (no secreto); el backend verifica que la clave corresponda.
EE_SERVICE_ACCOUNT_EMAIL=
CACHE_DIR=.cache
# Acceso y límites (ADR-0005). AUTH_MODE: optional (anónimo con cupo ligero) | required (todo análisis nuevo con token)
AUTH_MODE=optional
# API_KEYS_FILE=            # por defecto .cache/security/api_keys.json (solo hashes)
MAX_ROI_AREA_KM2=2000000
LIGHT_MAX_IMAGES=50000
LIGHT_MAX_PIXEL_IMAGES=5e7
HEAVY_MAX_IMAGES=600000
HEAVY_MAX_PIXEL_IMAGES=3e9
ANON_EXTRACTIONS_PER_HOUR=20
KEY_EXTRACTIONS_PER_HOUR=200
MAX_CONCURRENT_EXTRACTIONS=2
# Cliente SDK / notebooks
EARTH_TREND_API_URL=http://localhost:8000/api/v1
EARTH_TREND_API_TOKEN=
