{
  "name": "earth-trend-web",
  "version": "0.1.0",
  "private": true,
  "description": "Interfaz web de Earth Trend Studio (nombre provisional). No calcula estadística: consume la API v1.",
  "scripts": {
    "tokens": "node ../../packages/design-tokens/build.mjs",
    "predev": "npm run tokens && npm run assets",
    "dev": "next dev --port 3000",
    "prebuild": "npm run tokens && npm run assets",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/copy-maplibre-worker.mjs",
    "check:contrast": "node ../../packages/design-tokens/check-contrast.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "echarts": "6.1.0",
    "maplibre-gl": "6.18.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
